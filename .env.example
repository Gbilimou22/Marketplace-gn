# -----------------------------------------------------------------------------
# Configuration d'environnement - Place de Marché Guinée (Exemple)
# -----------------------------------------------------------------------------
# Copiez ce fichier vers .env et adaptez les valeurs selon votre environnement.
# Ne commitez JAMAIS le fichier .env réel contenant des secrets.

# Paramètres généraux Django
DEBUG=True
SECRET_KEY=change-me-in-production-use-a-secure-secret-key-min-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Base de données PostgreSQL (locale via Docker ou native)
DATABASE_URL=postgres://marketplace_user:marketplace_password@localhost:5432/marketplace_db

# Paramètres régionaux et métier (Guinée)
TIME_ZONE=Africa/Conakry
LANGUAGE_CODE=fr-fr
CURRENCY_CODE=GNF

# Poids et seuils bayésiens (Réputation vendeurs)
BAYESIAN_MIN_REVIEWS_THRESHOLD=10
DEFAULT_PAGE_SIZE=20

# E-mails (en dev: console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
